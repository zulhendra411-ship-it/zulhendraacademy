        // TIMER COUNTER (45 MENIT HITUNG MUNDUR)
        function startTimer() {
            clearInterval(timerInterval);
            const timerDisplay = document.getElementById('timerDisplay');
            const timerBadge = document.getElementById('timerBadge');

            timerInterval = setInterval(() => {
                remainingSeconds--;

                if (remainingSeconds <= 0) {
                    clearInterval(timerInterval);
                    timerDisplay.innerText = "00:00";
                    alert("Waktu pengerjaan ujian (45 Menit) telah habis! Jawaban Anda akan otomatis dikumpulkan.");
                    finishQuiz();
                    return;
                }

                const mins = Math.floor(remainingSeconds / 60).toString().padStart(2, '0');
                const secs = (remainingSeconds % 60).toString().padStart(2, '0');
                timerDisplay.innerText = `${mins}:${secs}`;

                if (remainingSeconds <= 300) {
                    timerBadge.className = "inline-block bg-rose-500 text-white px-3 py-1.5 rounded-full text-xs font-bold animate-pulse shadow-md";
                }
            }, 1000);
        }

