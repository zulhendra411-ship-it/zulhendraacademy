        // INIT FIREBASE AUTH & FIRESTORE
        async function initFirebase() {
            try {
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    const userCred = await signInWithCustomToken(auth, __initial_auth_token);
                    currentUser = userCred.user;
                } else {
                    const userCred = await signInAnonymously(auth);
                    currentUser = userCred.user;
                }

                setupRealtimeListeners();
            } catch (err) {
                console.warn("Firebase initialized in fallback mode:", err);
            }
        }

        function setupRealtimeListeners() {
            if (!db || !currentUser) return;

            const resultsCol = collection(db, 'artifacts', appId, 'public', 'data', 'exam_results');
            const activeCol = collection(db, 'artifacts', appId, 'public', 'data', 'active_sessions');

            onSnapshot(resultsCol, (snapshot) => {
                remoteResultsList = [];
                snapshot.forEach((docSnap) => {
                    remoteResultsList.push({ id: docSnap.id, ...docSnap.data() });
                });
                renderAdminDashboard();
            }, (err) => console.error("Results snapshot err:", err));

            onSnapshot(activeCol, (snapshot) => {
                remoteActiveList = [];
                const now = Date.now();
                snapshot.forEach((docSnap) => {
                    const data = docSnap.data();
                    if (now - (data.lastActive || 0) < 3600000) {
                        remoteActiveList.push({ id: docSnap.id, ...data });
                    }
                });
                renderAdminDashboard();
            }, (err) => console.error("Active snapshot err:", err));
