                renderQuestion(currentQuestion);
            } else {
                finishQuiz();
            }
        }

        function toggleQuestionGrid() {
            const modal = document.getElementById('questionGridModal');
            if (modal) {
                modal.classList.toggle('hidden');
                if (!modal.classList.contains('hidden')) {
                    renderGridModal();
                }
            }
        }

        function renderGridModal() {
            const container = document.getElementById('questionGridContainer');
            if (!container) return;
            container.innerHTML = '';

            quizData.forEach((item, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';

                let btnClass = "p-2.5 rounded-xl font-bold text-xs flex items-center justify-center transition-all shadow-2xs ";

                if (idx === currentQuestion) {
                    btnClass += "ring-2 ring-brand-600 bg-brand-600 text-white shadow-md scale-105";
                } else if (userAnswers[idx] !== null) {
                    if (userAnswers[idx] === item.correct) {
                        btnClass += "bg-emerald-500 text-white";
                    } else {
                        btnClass += "bg-rose-500 text-white";
                    }
                } else {
                    btnClass += "bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200";
                }

                btn.className = btnClass;
                btn.innerText = idx + 1;
                btn.onclick = () => {
                    currentQuestion = idx;
                    renderQuestion(currentQuestion);
                    toggleQuestionGrid();
                };

                container.appendChild(btn);
            });
        }

        async function finishQuiz() {
            clearInterval(timerInterval);

            document.getElementById('quizScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.remove('hidden');
            document.getElementById('quizHeaderInfo').classList.add('hidden');

            let correctCount = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === quizData[idx].correct) correctCount++;
            });

            const wrongCount = quizData.length - correctCount;
            const finalScore = Math.round((correctCount / quizData.length) * 100);

            document.getElementById('finalScoreDisplay').innerText = finalScore;
            document.getElementById('resStudentName').innerText = studentName;
            document.getElementById('resStudentClass').innerText = studentClass;
            document.getElementById('resCorrectCount').innerText = `${correctCount} Soal`;
            document.getElementById('resWrongCount').innerText = `${wrongCount} Soal`;

            // Save completed result to Firestore & remove active session
            if (db && currentUser) {
                if (studentSessionId) {
                    const sessionDoc = doc(db, 'artifacts', appId, 'public', 'data', 'active_sessions', studentSessionId);
                    await deleteDoc(sessionDoc).catch(err => console.error(err));
                }

                const resultDoc = doc(collection(db, 'artifacts', appId, 'public', 'data', 'exam_results'));
                await setDoc(resultDoc, {
                    studentName,
                    studentClass,
                    score: finalScore,
                    correctCount,
                    wrongCount,
                    totalQuestions: quizData.length,
                    completedAt: new Date().toLocaleString('id-ID'),
                    timestamp: Date.now()
                }).catch(err => console.error(err));
            }

            const badgeIcon = document.getElementById('badgeIconContainer');
            const predicate = document.getElementById('resultPredicate');

            if (finalScore >= 85) {
                badgeIcon.innerHTML = "🏆";
                predicate.innerText = "Sangat Memuaskan (Sangat Baik)!";
                predicate.className = "text-base font-bold text-emerald-600 mt-2";
            } else if (finalScore >= 70) {
                badgeIcon.innerHTML = "🥇";
                predicate.innerText = "Baik & Tuntas!";
                predicate.className = "text-base font-bold text-brand-600 mt-2";
            } else if (finalScore >= 50) {
                badgeIcon.innerHTML = "🎯";
                predicate.innerText = "Cukup (Perlu Ditingkatkan)";
                predicate.className = "text-base font-bold text-amber-600 mt-2";
            } else {
                badgeIcon.innerHTML = "💡";
                predicate.innerText = "Perlu Belajar & Remedial";
                predicate.className = "text-base font-bold text-rose-600 mt-2";
            }

            confetti({
                particleCount: 100,
                spread: 70,
                origin: { y: 0.6 }
            });

            renderReview('all');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ADMIN PANEL FUNCTIONS & DASHBOARD RENDER
        function openAdminModal() {
            document.getElementById('adminLoginModal').classList.remove('hidden');
            document.getElementById('adminPasswordInput').value = '';
            document.getElementById('adminPassError').classList.add('hidden');
        }

        function closeAdminModal() {
            document.getElementById('adminLoginModal').classList.add('hidden');
        }

        function verifyAdmin() {
            const pass = document.getElementById('adminPasswordInput').value;
            if (pass === 'admin123' || pass === 'admin') {
                closeAdminModal();
                document.getElementById('loginScreen').classList.add('hidden');
                document.getElementById('quizScreen').classList.add('hidden');
                document.getElementById('resultScreen').classList.add('hidden');
                document.getElementById('adminScreen').classList.remove('hidden');
                renderAdminDashboard();
            } else {
                document.getElementById('adminPassError').classList.remove('hidden');
            }
        }

        function closeAdminScreen() {
            document.getElementById('adminScreen').classList.add('hidden');
            document.getElementById('loginScreen').classList.remove('hidden');
        }

        function switchAdminTab(tab) {
            const tabActiveBtn = document.getElementById('tabActiveBtn');
            const tabRecapBtn = document.getElementById('tabRecapBtn');
            const tabActiveView = document.getElementById('adminTabActive');
            const tabRecapView = document.getElementById('adminTabRecap');

            if (tab === 'active') {
                tabActiveBtn.className = "py-3 px-5 border-b-2 border-brand-600 text-brand-600 flex items-center space-x-2";
                tabRecapBtn.className = "py-3 px-5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2";
                tabActiveView.classList.remove('hidden');
                tabRecapView.classList.add('hidden');
            } else {
                tabRecapBtn.className = "py-3 px-5 border-b-2 border-brand-600 text-brand-600 flex items-center space-x-2";
                tabActiveBtn.className = "py-3 px-5 border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center space-x-2";
                tabRecapView.classList.remove('hidden');
                tabActiveView.classList.add('hidden');
            }
        }

        function renderAdminDashboard() {
            // Update Badges & Cards
            document.getElementById('statActiveCount').innerText = remoteActiveList.length;
            document.getElementById('statFinishedCount').innerText = remoteResultsList.length;

            document.getElementById('tabActiveBadge').innerText = remoteActiveList.length;
            document.getElementById('tabRecapBadge').innerText = remoteResultsList.length;

            // Calculate Avg & Max Score
            if (remoteResultsList.length > 0) {
                const totalScore = remoteResultsList.reduce((acc, curr) => acc + (curr.score || 0), 0);
                const avgScore = Math.round(totalScore / remoteResultsList.length);
                const maxScore = Math.max(...remoteResultsList.map(r => r.score || 0));

                document.getElementById('statAvgScore').innerText = avgScore;
                document.getElementById('statMaxScore').innerText = maxScore;
            } else {
                document.getElementById('statAvgScore').innerText = "0";
                document.getElementById('statMaxScore').innerText = "0";
            }

            // Render Active Students Table
            const activeTbody = document.getElementById('activeStudentsTableBody');
            activeTbody.innerHTML = '';

            if (remoteActiveList.length === 0) {
                activeTbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">Belum ada siswa yang sedang mengerjakan ujian.</td></tr>`;
            } else {
                remoteActiveList.forEach((stu) => {
                    const row = document.createElement('tr');
                    const progressPercent = Math.round((stu.currentQuestion / (stu.totalQuestions || 20)) * 100);
                    row.innerHTML = `
                        <td class="p-3 font-bold text-slate-800">${stu.studentName}</td>
                        <td class="p-3 font-semibold text-brand-700"><span class="bg-brand-50 px-2 py-1 rounded-lg border border-brand-100">${stu.studentClass}</span></td>
                        <td class="p-3 text-slate-500">${stu.startTime || '-'}</td>
                        <td class="p-3">
                            <div class="flex items-center space-x-2">
                                <div class="w-24 bg-slate-100 h-2 rounded-full overflow-hidden">
                                    <div class="bg-brand-500 h-2" style="width: ${progressPercent}%"></div>
                                </div>
                                <span class="font-bold text-slate-700">${stu.currentQuestion} / ${stu.totalQuestions || 20}</span>
                            </div>
                        </td>
                        <td class="p-3">
                            <span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full text-[11px] inline-flex items-center">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping mr-1.5"></span> Sedang Pengerjaan
                            </span>
                        </td>
                    `;
                    activeTbody.appendChild(row);
                });
            }

            filterAdminRecap();
        }

        function filterAdminRecap() {
            const search = (document.getElementById('adminSearchInput').value || '').toLowerCase();
            const classFilter = document.getElementById('adminClassFilter').value;

            const tbody = document.getElementById('recapTableBody');
            tbody.innerHTML = '';

            let filtered = remoteResultsList.filter(item => {
                const matchName = (item.studentName || '').toLowerCase().includes(search);
                const matchClass = (classFilter === 'ALL') || (item.studentClass === classFilter);
                return matchName && matchClass;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400">Tidak ada data rekapitulasi ujian.</td></tr>`;
                return;
            }

            filtered.forEach((res, idx) => {
                const row = document.createElement('tr');
                row.className = "hover:bg-slate-50/80 transition-all";
                row.innerHTML = `
                    <td class="p-3 font-bold text-slate-400">${idx + 1}</td>
                    <td class="p-3 font-bold text-slate-900">${res.studentName}</td>
                    <td class="p-3"><span class="bg-brand-50 text-brand-700 border border-brand-200 font-bold px-2 py-0.5 rounded-lg text-xs">${res.studentClass}</span></td>
                    <td class="p-3 font-black text-sm text-brand-700">${res.score}</td>
                    <td class="p-3"><span class="text-emerald-600 font-bold">${res.correctCount} B</span> / <span class="text-rose-600 font-bold">${res.wrongCount} S</span></td>
                    <td class="p-3 text-slate-500">${res.completedAt || '-'}</td>
                    <td class="p-3">
                        <button onclick="deleteResultRecord('${res.id}')" class="text-rose-500 hover:text-rose-700 font-bold text-xs p-1">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        async function deleteResultRecord(recordId) {
            if (!confirm("Apakah Anda yakin ingin menghapus data rekap peserta ini?")) return;
            if (db && currentUser && recordId) {
                const itemDoc = doc(db, 'artifacts', appId, 'public', 'data', 'exam_results', recordId);
                await deleteDoc(itemDoc).catch(err => console.error(err));
            }
        }

        function exportAdminExcel() {
            if (remoteResultsList.length === 0) {
                alert("Belum ada data hasil ujian untuk diunduh.");
                return;
            }

            const classFilter = document.getElementById('adminClassFilter').value;
            let filtered = remoteResultsList.filter(item => (classFilter === 'ALL') || (item.studentClass === classFilter));

            let csvContent = "\uFEFF";
            csvContent += "REKAPITULASI HASIL UJIAN EKONOMI KELAS X - ZULHENDRA ACADEMY\n";
            csvContent += `Filter Kelas,${classFilter}\n`;
            csvContent += `Tanggal Cetak,${new Date().toLocaleDateString('id-ID')}\n\n`;
            csvContent += "No,Nama Peserta,Kelas,Skor Akhir,Jumlah Benar,Jumlah Salah,Total Soal,Waktu Selesai\n";

            filtered.forEach((res, idx) => {
                csvContent += `${idx + 1},"${res.studentName}","${res.studentClass}",${res.score},${res.correctCount},${res.wrongCount},${res.totalQuestions || 20},"${res.completedAt || '-'}"\n`;
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `Rekap_Ujian_ZHA_Kelas_${classFilter}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function filterReview(type) {
            document.getElementById('filterAllBtn').className = (type === 'all') ? "px-3 py-1.5 rounded-lg bg-white text-brand-700 shadow-xs font-bold" : "px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900";
            document.getElementById('filterCorrectBtn').className = (type === 'correct') ? "px-3 py-1.5 rounded-lg bg-white text-emerald-700 shadow-xs font-bold" : "px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900";
            document.getElementById('filterWrongBtn').className = (type === 'wrong') ? "px-3 py-1.5 rounded-lg bg-white text-rose-700 shadow-xs font-bold" : "px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900";

            renderReview(type);
        }

        function renderReview(type) {
            const container = document.getElementById('reviewContainer');
            if (!container) return;
            container.innerHTML = '';

            const labels = ['A', 'B', 'C', 'D', 'E'];

            quizData.forEach((q, idx) => {
                const isCorrect = userAnswers[idx] === q.correct;
                if (type === 'correct' && !isCorrect) return;
                if (type === 'wrong' && isCorrect) return;

                const userChoice = userAnswers[idx] !== null ? labels[userAnswers[idx]] : 'Tidak Dijawab';
                const correctChoice = labels[q.correct];

                const card = document.createElement('div');
                card.className = `p-4 sm:p-5 rounded-2xl border ${isCorrect ? 'bg-emerald-50/40 border-emerald-200' : 'bg-rose-50/40 border-rose-200'} text-xs sm:text-sm space-y-2`;

                card.innerHTML = `
                    <div class="flex items-center justify-between font-bold">
                        <span class="text-slate-800">Soal #${q.id} (${q.level})</span>
                        <span class="${isCorrect ? 'text-emerald-700 bg-emerald-100' : 'text-rose-700 bg-rose-100'} px-2.5 py-0.5 rounded-full text-xs">
                            ${isCorrect ? '<i class="fa-solid fa-check mr-1"></i> Benar' : '<i class="fa-solid fa-xmark mr-1"></i> Salah'}
                        </span>
                    </div>
                    <p class="font-semibold text-slate-900">${q.question}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 font-medium text-xs">
                        <div class="p-2 rounded-xl ${isCorrect ? 'bg-emerald-100/60 text-emerald-900' : 'bg-rose-100/60 text-rose-900'}">
                            <strong>Jawaban Anda:</strong> ${userChoice}. ${userAnswers[idx] !== null ? q.options[userAnswers[idx]] : 'Tidak Dijawab'}
                        </div>
                        <div class="p-2 rounded-xl bg-emerald-100/60 text-emerald-900">
                            <strong>Kunci Jawaban:</strong> ${correctChoice}. ${q.options[q.correct]}
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-t border-slate-200/60 text-slate-700 leading-relaxed">
                        <span class="font-bold text-brand-800"><i class="fa-solid fa-lightbulb text-amber-500 mr-1"></i> Pembahasan:</span>
                        <div class="mt-1">${q.explanation}</div>
                    </div>
                `;

                container.appendChild(card);
            });
        }

        // EXPOSE GLOBAL FUNCTIONS TO WINDOW FOR INLINE HTML LISTENERS
        window.startQuiz = startQuiz;
        window.prevQuestion = prevQuestion;
        window.nextQuestion = nextQuestion;
        window.toggleQuestionGrid = toggleQuestionGrid;
        window.filterReview = filterReview;
        window.openCertificateModal = () => document.getElementById('certificateModal').classList.remove('hidden');
        window.closeCertificateModal = () => document.getElementById('certificateModal').classList.add('hidden');
        window.printCertificate = () => window.print();
        window.printResults = () => window.print();
        window.restartQuiz = () => {
            currentQuestion = 0;
            userAnswers = new Array(quizData.length).fill(null);
            clearInterval(timerInterval);
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('loginScreen').classList.remove('hidden');
        };

        window.openAdminModal = openAdminModal;
        window.closeAdminModal = closeAdminModal;
        window.verifyAdmin = verifyAdmin;
        window.closeAdminScreen = closeAdminScreen;
        window.switchAdminTab = switchAdminTab;
        window.filterAdminRecap = filterAdminRecap;
        window.deleteResultRecord = deleteResultRecord;
        window.exportAdminExcel = exportAdminExcel;
        window.exportToExcel = exportAdminExcel;
    </script>
</body>
</html>
