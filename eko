                    } else {
                        btnClass += "bg-rose-500 text-white";
                    }
                } else {
                    btnClass += "bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200";
                }

                btn.className = btnClass;
                btn.innerText = idx + 1;
                btn.onclick = () => {
                    currentQuestion = idx;
                    renderQuestion(currentQuestion);
                };

                container.appendChild(btn);
            });
        }

