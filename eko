<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuis Online Ekonomi Kelas X - Kebutuhan Manusia</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti untuk Efek Jawaban Benar & Hasil Akhir -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Custom Theme Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                            800: '#0c4a6e',
                            900: '#0a3751',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f9ff;
            -webkit-tap-highlight-color: transparent;
        }

        /* Smooth Transition Effects */
        .fade-in {
            animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Custom Scrollbar for mobile/desktop */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #e0f2fe;
        }
        ::-webkit-scrollbar-thumb {
            background: #38bdf8;
            border-radius: 999px;
        }

        /* Styles khusus untuk Mode Cetak / PDF Recap */
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white !important; color: black !important; }
            .shadow-xl, .shadow-md, .shadow-sm { box-shadow: none !important; }
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between selection:bg-brand-200 selection:text-brand-900">

    <!-- HEADER APLIKASI -->
    <header class="bg-gradient-to-r from-brand-700 via-brand-600 to-sky-600 text-white shadow-lg sticky top-0 z-30 no-print">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <!-- LOGO ZHA -->
                <div class="bg-white text-brand-700 font-black px-2.5 py-1.5 rounded-xl text-lg shadow-md tracking-wider border border-brand-200">
                    ZHA
                </div>
                <div>
                    <h1 class="font-extrabold text-base sm:text-lg leading-tight tracking-wide">ZULHENDRA ACADEMY</h1>
                    <p class="text-xs text-sky-100 font-medium">Kuis Ekonomi Kelas X: Kebutuhan Manusia</p>
                </div>
            </div>
            <!-- Indicator Status / Timer 45 Menit -->
            <div id="quizHeaderInfo" class="hidden text-right">
                <span id="timerBadge" class="inline-block bg-white/20 px-3 py-1.5 rounded-full text-xs font-bold backdrop-blur-md border border-white/20">
                    <i class="fa-regular fa-clock mr-1"></i> Sisa Waktu: <span id="timerDisplay">45:00</span>
                </span>
            </div>

            <!-- TOMBOL AKSES ADMIN -->
            <button onclick="openAdminModal()" class="bg-white/10 hover:bg-white/20 text-white border border-white/30 text-xs font-bold px-3 py-1.5 rounded-xl transition-all flex items-center space-x-1.5 ml-2 active:scale-95">
                <i class="fa-solid fa-user-shield text-amber-300"></i>
                <span class="hidden sm:inline">Menu Admin</span>
            </button>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-4xl mx-auto px-3 sm:px-6 py-4 sm:py-6 flex-grow w-full">

        <!-- ================= 1. HALAMAN LOGIN / IDENTITAS PESERTA ================= -->
        <section id="loginScreen" class="fade-in max-w-lg mx-auto bg-white rounded-3xl shadow-xl border border-brand-100 p-6 sm:p-8 mt-2 sm:mt-6">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-gradient-to-br from-brand-500 to-sky-600 text-white rounded-2xl flex items-center justify-center mx-auto mb-3 shadow-md font-black text-2xl tracking-widest">
                    ZHA
                </div>
                <h2 class="text-2xl font-extrabold text-brand-900">Zulhendra Academy</h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Ujian Online Ekonomi Kelas X • Waktu Pengerjaan 45 Menit</p>
            </div>

            <form id="loginForm" onsubmit="startQuiz(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputName">
                        <i class="fa-solid fa-user mr-1 text-brand-500"></i> Nama Lengkap Peserta
                    </label>
                    <input type="text" id="inputName" required placeholder="Contoh: Sari Mahalia"
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 transition-all outline-none font-medium text-slate-800 text-sm bg-slate-50 focus:bg-white">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="inputClass">
                        <i class="fa-solid fa-users text-brand-500 mr-1"></i> Kelas
                    </label>
                    <select id="inputClass" required class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 transition-all outline-none font-medium text-slate-800 text-sm bg-slate-50 focus:bg-white">
                        <option value="" disabled selected>-- Pilih Kelas --</option>
                        <option value="XA">XA</option>
                        <option value="XB">XB</option>
                        <option value="XC">XC</option>
                        <option value="XD">XD</option>
                        <option value="XE">XE</option>
                        <option value="XF">XF</option>
                    </select>
                </div>

                <!-- Petunjuk Ujian -->
                <div class="bg-brand-50 border border-brand-200 rounded-2xl p-4 text-xs text-brand-900 space-y-1.5">
                    <p class="font-bold text-brand-700 flex items-center">
                        <i class="fa-solid fa-circle-info mr-1.5 text-sm"></i> Petunjuk Ujian:
                    </p>
                    <ul class="list-disc list-inside space-y-1 text-slate-600 pl-1">
                        <li>Jumlah soal: <strong>20 Soal Pilihan Ganda</strong>.</li>
                        <li>Durasi Waktu: <strong>45 Menit</strong> (Hitung mundur otomatis).</li>
                        <li>Terdapat <strong>efek suara</strong> dan <strong>pembahasan</strong> pada setiap jawaban.</li>
                        <li>Tersedia fitur <strong>Ekspor Nilai ke Excel</strong> dan <strong>Unduh Sertifikat</strong>.</li>
                    </ul>
                </div>

                <button type="submit" 
                    class="w-full bg-gradient-to-r from-brand-600 to-sky-600 hover:from-brand-700 hover:to-sky-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-lg shadow-brand-500/30 transform active:scale-95 transition-all flex items-center justify-center space-x-2 text-base">
                    <span>Mulai Ujian Sekarang</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>
        </section>


        <!-- ================= 2. HALAMAN KUIS / SOAL INTERAKTIF ================= -->
        <section id="quizScreen" class="hidden fade-in space-y-4">
            
            <!-- User Info & Progress Bar Panel -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-brand-100 flex flex-col gap-3">
                <div class="flex items-center justify-between text-xs sm:text-sm">
                    <div class="flex items-center space-x-2">
                        <span class="bg-brand-100 text-brand-800 font-bold px-2.5 py-1 rounded-lg">
                            <i class="fa-solid fa-user-check mr-1"></i> <span id="displayStudentName"></span>
                        </span>
                        <span class="bg-sky-100 text-sky-800 font-bold px-2.5 py-1 rounded-lg">
                            <span id="displayStudentClass"></span>
                        </span>
                    </div>
                    <div class="font-bold text-brand-700">
                        Soal <span id="currentQuestionNum" class="text-base font-extrabold">1</span> / 20
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                    <div id="progressBar" class="bg-gradient-to-r from-brand-400 to-sky-600 h-2.5 rounded-full transition-all duration-300" style="width: 5%"></div>
                </div>

                <!-- DIRECT QUESTION NAVIGATION GRID (NOMOR 1 - 20) -->
                <div class="pt-2 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                            <i class="fa-solid fa-grip mr-1 text-brand-500"></i> Navigasi Nomor Soal:
                        </span>
                        <span class="text-[11px] text-slate-400">Klik nomor untuk pindah</span>
                    </div>
                    <div id="inlineQuestionGrid" class="flex flex-wrap gap-1.5 sm:gap-2">
                        <!-- Number buttons 1..20 populated dynamically via JS -->
                    </div>
                </div>
            </div>

            <!-- Quiz Main Card -->
            <div class="bg-white rounded-3xl shadow-lg border border-brand-100 p-4 sm:p-7 relative overflow-hidden">
                
                <!-- Badge Level & Category -->
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4 pb-3 border-b border-slate-100">
                    <span id="badgeLevel" class="text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider bg-emerald-100 text-emerald-700">
                        Mudah
                    </span>
                    <span id="badgeTag" class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-600">
                        Literasi Konsep
                    </span>
                </div>

                <!-- Context Passage / Image / Table (If Exists) -->
                <div id="passageContainer" class="hidden mb-4 bg-slate-50 border-l-4 border-brand-500 p-3.5 sm:p-4 rounded-r-2xl text-xs sm:text-sm text-slate-700 font-medium leading-relaxed">
                    <!-- Passage text inserted here via JS -->
                </div>

                <!-- Question Text -->
                <h3 id="questionText" class="text-base sm:text-lg font-bold text-slate-900 leading-snug mb-5">
                    <!-- Question text inserted here -->
                </h3>

                <!-- Options List (A, B, C, D, E) -->
                <div id="optionsContainer" class="space-y-2.5 sm:space-y-3">
                    <!-- Options buttons rendered dynamically via JS -->
                </div>

                <!-- Interactive Feedback Banner (Correct / Incorrect) -->
                <div id="feedbackBox" class="hidden mt-6 fade-in p-4 rounded-2xl border text-sm font-medium transition-all">
                    <!-- Dynamic feedback content -->
                </div>

                <!-- Explanation Box (Pembahasan Soal) -->
                <div id="explanationBox" class="hidden mt-4 fade-in bg-brand-50/80 border border-brand-200 rounded-2xl p-4 sm:p-5 text-xs sm:text-sm text-slate-800">
                    <div class="flex items-center space-x-2 font-bold text-brand-800 mb-2 border-b border-brand-200/60 pb-2">
                        <i class="fa-solid fa-lightbulb text-amber-500 text-base"></i>
                        <span>Pembahasan Soal:</span>
                    </div>
                    <div id="explanationText" class="leading-relaxed text-slate-700 space-y-1">
                        <!-- Explanation detail inserted here -->
                    </div>
                </div>

            </div>

            <!-- Quiz Navigation Bottom Controls -->
            <div class="flex items-center justify-between pt-2">
                <button id="btnPrev" onclick="prevQuestion()" disabled
                    class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 disabled:opacity-40 disabled:cursor-not-allowed font-semibold px-4 py-2.5 rounded-xl text-xs sm:text-sm transition-all flex items-center space-x-1.5 shadow-sm">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                    <span>Sebelumnya</span>
                </button>

                <!-- Quick Navigation Question Drawer Button -->
                <button onclick="toggleQuestionGrid()" class="bg-brand-50 hover:bg-brand-100 text-brand-700 font-bold px-3 py-2 rounded-xl text-xs flex items-center space-x-1.5 border border-brand-200 transition-all">
                    <i class="fa-solid fa-grip"></i>
                    <span>Daftar Soal</span>
                </button>

                <button id="btnNext" onclick="nextQuestion()"
                    class="bg-brand-600 hover:bg-brand-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs sm:text-sm transition-all flex items-center space-x-1.5 shadow-md shadow-brand-500/20 active:scale-95">
                    <span id="btnNextText">Selanjutnya</span>
                    <i id="btnNextIcon" class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            </div>

            <!-- Drawer Modal for Direct Question Jump -->
            <div id="questionGridModal" class="hidden fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4">
                <div class="bg-white rounded-3xl max-w-sm w-full p-5 shadow-2xl border border-brand-100 fade-in">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-bold text-slate-800 text-sm flex items-center">
                            <i class="fa-solid fa-list-ol mr-2 text-brand-500"></i> Navigasi Soal
                        </h4>
                        <button onclick="toggleQuestionGrid()" class="text-slate-400 hover:text-slate-600 p-1">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                    </div>
                    <div id="questionGridContainer" class="grid grid-cols-5 gap-2 max-h-60 overflow-y-auto p-1">
                        <!-- Number buttons rendered via JS -->
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                        <span class="flex items-center"><span class="w-3 h-3 rounded-full bg-emerald-500 mr-1"></span> Benar</span>
                        <span class="flex items-center"><span class="w-3 h-3 rounded-full bg-rose-500 mr-1"></span> Salah</span>
                        <span class="flex items-center"><span class="w-3 h-3 rounded-full bg-brand-600 mr-1"></span> Aktif</span>
                        <span class="flex items-center"><span class="w-3 h-3 rounded-full bg-slate-200 mr-1"></span> Belum</span>
                    </div>
                </div>
            </div>

        </section>


        <!-- ================= 3. HALAMAN REKAP HASIL AKHIR ================= -->
        <section id="resultScreen" class="hidden fade-in space-y-6">
            
            <!-- Result Overview Header Card -->
            <div class="bg-white rounded-3xl shadow-xl border border-brand-100 p-6 sm:p-8 text-center relative overflow-hidden">
                <div class="absolute top-0 left-0 right-0 h-3 bg-gradient-to-r from-brand-500 via-sky-500 to-blue-600"></div>

                <div id="badgeIconContainer" class="w-20 h-20 bg-brand-100 text-brand-600 rounded-full flex items-center justify-center mx-auto mb-3 text-4xl shadow-inner mt-2">
                    🏆
                </div>

                <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Hasil Ujian Online</h2>
                <p class="text-xs text-brand-600 font-bold uppercase tracking-widest mt-0.5">Zulhendra Academy</p>
                <p id="resultPredicate" class="text-base font-bold text-brand-600 mt-2">Sangat Memuaskan!</p>
                <p class="text-xs text-slate-500">Ekonomi Kelas X - Materi Kebutuhan Manusia</p>

                <!-- Big Score Gauge Display -->
                <div class="my-6 inline-block bg-gradient-to-br from-brand-50 to-sky-100 border border-brand-200 rounded-3xl px-8 py-5 shadow-inner">
                    <span class="block text-xs font-bold text-brand-700 uppercase tracking-widest mb-1">SKOR AKHIR ANDA</span>
                    <span id="finalScoreDisplay" class="text-5xl sm:text-6xl font-black text-brand-700">0</span>
                    <span class="text-sm font-semibold text-slate-500"> / 100</span>
                </div>

                <!-- Student Details & Statistics Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl mx-auto text-left">
                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                        <span class="block text-[11px] text-slate-400 font-medium">Nama Peserta</span>
                        <span id="resStudentName" class="font-bold text-xs sm:text-sm text-slate-800 truncate block"></span>
                    </div>
                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                        <span class="block text-[11px] text-slate-400 font-medium">Kelas</span>
                        <span id="resStudentClass" class="font-bold text-xs sm:text-sm text-slate-800 block"></span>
                    </div>
                    <div class="bg-emerald-50 p-3 rounded-2xl border border-emerald-100">
                        <span class="block text-[11px] text-emerald-600 font-medium"><i class="fa-solid fa-circle-check"></i> Jawaban Benar</span>
                        <span id="resCorrectCount" class="font-bold text-sm text-emerald-700">0 Soal</span>
                    </div>
                    <div class="bg-rose-50 p-3 rounded-2xl border border-rose-100">
                        <span class="block text-[11px] text-rose-600 font-medium"><i class="fa-solid fa-circle-xmark"></i> Jawaban Salah</span>
                        <span id="resWrongCount" class="font-bold text-sm text-rose-700">0 Soal</span>
                    </div>
                </div>

                <!-- Action Buttons (Export to Excel & Certificate) -->
                <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5 no-print">
                    <button onclick="openCertificateModal()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold px-4 py-3 rounded-xl text-xs sm:text-sm transition-all flex items-center space-x-2 shadow-md">
                        <i class="fa-solid fa-award text-base"></i>
                        <span>Unduh Sertifikat</span>
                    </button>
                    <button onclick="exportToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-3 rounded-xl text-xs sm:text-sm transition-all flex items-center space-x-2 shadow-md">
                        <i class="fa-solid fa-file-excel"></i>
                        <span>Ekspor Excel (.csv)</span>
                    </button>
                    <button onclick="printResults()" class="bg-slate-800 hover:bg-slate-900 text-white font-bold px-4 py-3 rounded-xl text-xs sm:text-sm transition-all flex items-center space-x-2 shadow-md">
                        <i class="fa-solid fa-print"></i>
                        <span>Cetak / PDF</span>
                    </button>
                    <button onclick="restartQuiz()" class="bg-brand-600 hover:bg-brand-700 text-white font-bold px-4 py-3 rounded-xl text-xs sm:text-sm transition-all flex items-center space-x-2 shadow-md shadow-brand-500/20">
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>Ulangi Ujian</span>
                    </button>
                </div>
            </div>

            <!-- Detailed Answers & Pembahasan Review Section -->
            <div class="bg-white rounded-3xl shadow-md border border-brand-100 p-5 sm:p-7">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-3 border-b border-slate-100">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 flex items-center">
                            <i class="fa-solid fa-list-check text-brand-500 mr-2"></i> Evaluasi & Pembahasan Lengkap
                        </h3>
                        <p class="text-xs text-slate-500">Tinjau kembali kunci jawaban dan pembahasan tiap nomor soal.</p>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="flex items-center space-x-1.5 bg-slate-100 p-1 rounded-xl text-xs font-semibold self-start no-print">
                        <button onclick="filterReview('all')" id="filterAllBtn" class="px-3 py-1.5 rounded-lg bg-white text-brand-700 shadow-xs">Semua</button>
                        <button onclick="filterReview('correct')" id="filterCorrectBtn" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900">Benar</button>
                        <button onclick="filterReview('wrong')" id="filterWrongBtn" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900">Salah</button>
                    </div>
                </div>

                <!-- Review Items Container -->
                <div id="reviewContainer" class="space-y-4">
                    <!-- Dynamically populated via JS -->
                </div>
            </div>

        </section>


        <!-- ================= 4. HALAMAN DASHBOARD ADMIN ================= -->
        <section id="adminScreen" class="hidden fade-in space-y-6">
            
            <!-- Admin Header Banner -->
            <div class="bg-gradient-to-r from-slate-900 via-brand-900 to-slate-800 text-white rounded-3xl p-6 shadow-xl relative overflow-hidden flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                    <span class="bg-amber-400 text-slate-900 font-extrabold text-[10px] px-2.5 py-1 rounded-md uppercase tracking-wider">
                        <i class="fa-solid fa-shield-halved mr-1"></i> Mode Administrator
                    </span>
                    <h2 class="text-2xl font-black tracking-tight">Dashboard Admin Zulhendra Academy</h2>
                    <p class="text-xs text-slate-300">Pantau siswa yang sedang ujian dan unduh rekapitulasi nilai kelas.</p>
                </div>
                <button onclick="closeAdminScreen()" class="bg-white/10 hover:bg-white/20 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition-all border border-white/20 shrink-0">
                    <i class="fa-solid fa-arrow-left mr-1.5"></i> Kembali ke Tampilan Siswa
                </button>
            </div>

            <!-- Stats Overview Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="bg-white p-4 rounded-2xl border border-brand-100 shadow-sm">
                    <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Sedang Ujian</span>
                    <span id="statActiveCount" class="text-2xl sm:text-3xl font-black text-brand-600">0</span>
                    <span class="text-xs text-slate-500 block mt-0.5">Siswa Aktif</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-brand-100 shadow-sm">
                    <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Selesai Ujian</span>
                    <span id="statFinishedCount" class="text-2xl sm:text-3xl font-black text-emerald-600">0</span>
                    <span class="text-xs text-slate-500 block mt-0.5">Total Responden</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-brand-100 shadow-sm">
                    <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Rata-rata Nilai</span>
                    <span id="statAvgScore" class="text-2xl sm:text-3xl font-black text-sky-600">0</span>
                    <span class="text-xs text-slate-500 block mt-0.5">Skor Kelas</span>
                </div>
                <div class="bg-white p-4 rounded-2xl border border-brand-100 shadow-sm">
                    <span class="block text-[11px] font-bold text-slate-400 uppercase tracking-wider">Nilai Tertinggi</span>
                    <span id="statMaxScore" class="text-2xl sm:text-3xl font-black text-amber-500">0</span>
                    <span class="text-xs text-slate-500 block mt-0.5">Pencapaian Maksimal</span>
                </div>
            </div>

            <!-- Admin Navigation Tabs -->
            <div class="flex border-b border-slate-200 text-xs sm:text-sm font-bold">
                <button onclick="switchAdminTab('active')" id="tabActiveBtn" class="py-3 px-5 border-b-2 border-brand-600 text-brand-600 flex items-center space-x-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
